# LLM: any OpenAI-compatible chat API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# Embedding: leave key/base URL empty to reuse OPENAI_API_KEY/OPENAI_BASE_URL.
# Rebuild the index after changing EMBEDDING_MODEL or EMBEDDING_DIMENSION.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development defaults. Docker Compose overrides NEO4J_URI and MILVUS_HOST
# inside the backend container so service discovery still works there.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=what-to-eat

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=recipe_chunks

# Docker Compose app ports and frontend proxy settings.
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api
INTERNAL_API_BASE_URL=http://backend:8000/api
